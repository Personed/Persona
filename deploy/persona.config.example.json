{
  "model": { "provider": "deepseek", "modelId": "deepseek-flash" },
  "dataDir": "/data",
  "deployment": "container",
  "computer": {
    "kind": "docker",
    "id": "personal",
    "image": "persona-workspace:3",
    "volume": "persona-personal-work",
    "network": "none",
    "cpus": 2,
    "memoryMiB": 1024,
    "pids": 256,
    "timeoutSeconds": 120,
    "ssh": {
      "host": "work-host",
      "user": "persona-control",
      "identityFile": "/home/node/.ssh/id_ed25519",
      "knownHostsFile": "/home/node/.ssh/known_hosts",
      "hostKeyAlias": "persona-work-host"
    }
  }
}
