{
  "productName": "Persona",
  "version": "0.1.0",
  "identifier": "app.persona.desktop",
  "build": {
    "frontendDist": "target/setup-assets"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "pilot",
        "create": false,
        "title": "Persona",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "incognito": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'",
      "capabilities": [
        {
          "identifier": "local-setup",
          "local": true,
          "webviews": ["setup"],
          "permissions": [
            "allow-setup-state",
            "allow-setup-submit",
            "allow-setup-cancel",
            "allow-setup-docker"
          ]
        },
        {
          "identifier": "local-maintenance",
          "local": true,
          "webviews": ["maintenance"],
          "permissions": [
            "allow-maintenance-state",
            "allow-maintenance-start",
            "allow-maintenance-cancel"
          ]
        },
        {
          "identifier": "local-preparation",
          "local": true,
          "webviews": ["preparation"],
          "permissions": [
            "allow-preparation-state",
            "allow-preparation-start",
            "allow-preparation-cancel"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
