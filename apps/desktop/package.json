{
  "name": "@persona/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Persona desktop",
  "author": "Persona",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @persona/web build && cargo build --manifest-path src-tauri/Cargo.toml --locked",
    "dev": "pnpm --filter @persona/web build && cargo run --manifest-path src-tauri/Cargo.toml --locked",
    "test": "node --test --test-concurrency=1 src-tauri/*.test.mjs && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "dist": "node src-tauri/build-installer.mjs"
  },
  "dependencies": {
    "@persona/agent": "workspace:*",
    "@persona/hosting": "workspace:*",
    "@persona/ui": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
